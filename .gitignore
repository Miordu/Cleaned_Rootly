# Virtual environments (recreate with: python3 -m venv env && pip install -r requirements.txt)
env/
venv/
ENV/

# Python build and cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/

# Secrets and local settings (copy .env.example to .env)
.env
# The mobile app's .env only holds the server's public address, so it is kept
!mobile/.env

# Local databases
*.db
*.sqlite

# Photos people upload while using the app
static/uploads/*
!static/uploads/.gitkeep

# Flask
instance/
.webassets-cache

# Mac and editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Notes folder kept outside the repo
MD\ files/
