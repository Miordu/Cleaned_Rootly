# Rootly Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Flask Configuration
FLASK_APP=server.py
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URI=postgresql:///rootly
# Database the tests use (its name must contain "test"; the tests wipe it)
TEST_DATABASE_URI=postgresql:///rootly_test

# Plant Identification API
# Get your API key from: https://plant.id/
PLANT_ID_API_KEY=your-plant-id-api-key-here

# Botanical Data API
# Get your API key from: https://docs.trefle.io/
TREFLE_API_KEY=your-trefle-api-key-here

# Plant Care API
# Get your API key from: https://perenual.com/docs/api
PERENUAL_API_KEY=your-perenual-api-key-here

# Plant Health Assessment API (optional)
# Get your API key from: https://plantnet.org/
PLANTNET_API_KEY=your-plantnet-api-key-here

# Additional Configuration
# DEBUG=True turns on Flask's interactive debugger. Only use it on your own
# computer, never on a shared network or a live site.
DEBUG=True
# Where the dev server listens (127.0.0.1 = only this computer)
HOST=127.0.0.1
PORT=5001
# Set to True to print every SQL query
SQLALCHEMY_ECHO=False
LOG_LEVEL=INFO
